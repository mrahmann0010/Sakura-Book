{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["apps/web/.env", "apps/api/.env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      // @sakura/contracts compiles to dist/, which is gitignored — so a fresh
      // clone running `npm run dev` would start Next against a package that
      // does not exist yet. Building dependencies first makes that work
      // without anyone having to know the package is there.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      // Same reason as typecheck: the suite imports src, and src imports
      // @sakura/contracts from its built dist.
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
