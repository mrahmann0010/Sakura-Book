# Base URL of the API this app talks to from the browser. `NEXT_PUBLIC_`
# vars are inlined into the client bundle at build time, so this is not a
# secret — it's the same origin the API's WEB_ORIGIN in apps/api/.env allows.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Receiving numbers shown in the mobile-money checkout step (bKash/Rocket/
# Nagad). Public by design — customers are meant to see and copy them.
NEXT_PUBLIC_BKASH_NUMBER=01700000000
NEXT_PUBLIC_ROCKET_NUMBER=01700000000
NEXT_PUBLIC_NAGAD_NUMBER=01700000000
