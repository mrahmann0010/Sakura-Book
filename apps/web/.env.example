# Base URL of the API this app talks to from the browser. `NEXT_PUBLIC_`
# vars are inlined into the client bundle at build time, so this is not a
# secret — it's the same origin the API's WEB_ORIGIN in apps/api/.env allows.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical public origin of the shop, no trailing slash. Every absolute URL
# the crawler sees is built from it: /sitemap.xml, /robots.txt, and the
# canonical + hreflang tags on each page. Leave it unset locally and it falls
# back to http://localhost:3000 — but in production it MUST be the real domain,
# or the sitemap you submit to Google Search Console will list localhost URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The mobile-money checkout numbers (bKash/Rocket/Nagad) used to live here.
# They now come from the API's `GET /payments/numbers` — see BKASH_NUMBER /
# ROCKET_NUMBER / NAGAD_NUMBER and Payment Settings in apps/api/.env.example
# — so that an admin can change them without a frontend redeploy.

# Google Analytics 4 measurement ID (GA Admin → Data Streams → the "G-" ID).
# Not a secret — it ships in the page source of every GA site — but leave it
# unset outside production so dev runs and previews stay out of the property.
#
# Runtime only: no NEXT_PUBLIC_ prefix and no build argument. The browser asks
# /api/analytics-config for it on each load, so setting this on the running
# container (and restarting) turns analytics on without rebuilding anything.
G_ANALYTICS=

# Where the shop's uploaded covers and sample PDFs actually live. Used only by
# app/api/files/[...path]/route.ts, which streams them back from this app's own
# origin so the storage provider never appears in a page, a link or a network
# tab — see src/lib/storage-url.ts for the whole reasoning.
#
# The same value as apps/api/.env's SUPABASE_URL. There is deliberately no
# bucket setting to go with it: the bucket travels in the proxied path, so
# there is no second copy of it here to drift out of step with the API's.
#
# No NEXT_PUBLIC_ prefix and no build argument, deliberately: the route handler
# is `force-dynamic`, so it reads this from the *running* container. That keeps
# the storage host out of the client bundle (which would defeat the point) and
# lets it be changed with a restart rather than a rebuild — the same trade
# G_ANALYTICS makes above.
#
# No service-role key here, and there must never be one: the bucket is public
# and these reads are unauthenticated. Only the API, which writes, holds a key.
SUPABASE_URL=
