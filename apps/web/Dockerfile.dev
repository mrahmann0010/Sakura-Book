# syntax=docker/dockerfile:1.7
ARG NODE_VERSION=20.20-alpine
FROM node:${NODE_VERSION}
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --no-audit --no-fund

COPY . .

# @sakura/contracts resolves through its compiled dist/, which .dockerignore
# keeps out of the build context on purpose. Without this the image starts with
# the workspace symlink in place but nothing behind it, and Next fails with
# "Can't resolve '@sakura/contracts'".
RUN npm run build --workspace @sakura/contracts

EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
# Not through turbo: it runs tasks in strict env mode and strips anything it
# was not told about, including the addresses Compose injects (see
# API_INTERNAL_URL / REDIS_URL in docker-compose.yml). Contracts is built
# here rather than leaned on turbo's ^build for the same reason.
CMD ["sh", "-c", "npm run build --workspace @sakura/contracts && npm run dev --workspace @sakura/web"]
