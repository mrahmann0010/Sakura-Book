PORT=4000
# Origin allowed to call this API from the browser — the Next.js app's own
# origin, matching apps/web/.env's NEXT_PUBLIC_API_URL host.
WEB_ORIGIN=http://localhost:3000

# ---- shop policy ----
# One currency only; the schema stores bare *_cents integers with no currency
# column. See docs/backend-architecture.md §3.7.
CURRENCY=BDT
# Minor units (poisha, 1/100 taka) — so 6000 = ৳60 postage, waived at ৳1,500.
# Placeholder rates: confirm against the shop's actual courier.
DELIVERY_FLAT_CENTS=6000
FREE_DELIVERY_THRESHOLD_CENTS=150000

# ---- database (Supabase) ----
# Supabase is Postgres, so nothing in the schema or the ORM is Supabase-specific.
# What is specific is which of the three connection strings you use where.
# Find all of them in the dashboard: Project Settings → Database → Connection.
#
#   Transaction pooler  aws-0-<region>.pooler.supabase.com:6543   → DATABASE_URL
#   Session pooler      aws-0-<region>.pooler.supabase.com:5432   → DIRECT_DATABASE_URL
#   Direct              db.<ref>.supabase.co:5432                 → IPv6-only on
#                                                                   newer projects
#
# The app holds the transaction pooler: many short transactions over few server
# connections, which is this API's shape. Migrations and the seed use the
# session pooler, because transaction pooling hands consecutive statements
# different backends and drizzle-kit relies on session state — it fails
# intermittently rather than loudly when pooled.
# The password goes INLINE in both URLs below, in the <password> slot:
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler...
#                 └── user ───────────┘ └ password ┘└──── host ────────┘
#
# It is written twice, once per URL, and that is deliberate. It used to live in
# a single DATABASE_PASSWORD var that the app substituted into a ${...}
# placeholder — which read well here and broke everywhere else, because Docker
# Compose and most hosting panels expand ${...} in their own layer before the
# process starts. The placeholder was resolved, usually to nothing, before the
# app ever saw it. One complete URL per environment survives that.
#
# Paste it as Supabase generated it, unquoted. The one thing to watch: nothing
# percent-encodes it for you any more, so a password containing @ : / # ? or %
# must be encoded by hand (@ → %40, # → %23). Unencoded, those characters move
# where the URL parser thinks the host begins, and it surfaces as an
# authentication error pointing nowhere near the cause. If yours has them,
# regenerating the password in Supabase is usually easier than escaping it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# require = TLS without certificate verification, which is what the poolers
# expect. verify-full additionally checks the chain and needs Supabase's CA
# distributed to every machine that connects. disable is for a local Postgres
# with no TLS.
DATABASE_SSL=require

# Leave false on the transaction pooler: a statement prepared on one backend is
# missing from the next, which surfaces as `prepared statement "sN" does not
# exist` under concurrency. Safe to enable on a session or direct connection.
DATABASE_PREPARE=false

# Connection pool, per API instance. On Supabase the number to compare this
# against is the pooler's client limit, not the database's max_connections —
# a small project allows far fewer of the former.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30

# ---- payments ----
# Shared secret for verifying payment webhooks: HMAC-SHA256 over the raw request
# body, sent as an x-signature header. At least 16 characters.
#
# Optional, and its absence is a closed door: with no secret set, every webhook
# is rejected. A missing secret must never mean "skip the check" — this value is
# the only thing standing between an HTTP request and marking an order paid.
PAYMENTS_WEBHOOK_SECRET=

# ---- redis ----
# Backs the rate limiter, and runs in docker compose — it is the one piece of
# local infrastructure left. Optional: without it the throttler keeps
# per-instance counters, which is fine locally and weakens the enumeration
# limits on coupon validation and order lookup in production, where more than
# one instance runs.
REDIS_URL=redis://localhost:6379
