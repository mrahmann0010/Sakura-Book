PORT=4000
# Origin allowed to call this API from the browser — the Next.js app's own
# origin, matching apps/web/.env's NEXT_PUBLIC_API_URL host.
WEB_ORIGIN=http://localhost:3000

# ---- shop policy ----
# One currency only; the schema stores bare *_cents integers with no currency
# column. See docs/backend-architecture.md §3.7.
CURRENCY=BDT
# Minor units (poisha, 1/100 taka) — so 6000 = ৳60 postage, waived at ৳1,500.
# Placeholder rates: confirm against the shop's actual courier.
DELIVERY_FLAT_CENTS=6000
FREE_DELIVERY_THRESHOLD_CENTS=150000
# The division the shop currently ships from. Zone pricing (inside/outside
# Dhaka) is relative to this, not hardcoded to Dhaka — move the shipment point
# by changing this, or later by saving Settings → Shipping.
WAREHOUSE_DIVISION=dhaka

# ---- database (Supabase) ----
# Supabase is Postgres, so nothing in the schema or the ORM is Supabase-specific.
# What is specific is which of the three connection strings you use where.
# Find all of them in the dashboard: Project Settings → Database → Connection.
#
#   Transaction pooler  aws-0-<region>.pooler.supabase.com:6543   → DATABASE_URL
#   Session pooler      aws-0-<region>.pooler.supabase.com:5432   → DIRECT_DATABASE_URL
#   Direct              db.<ref>.supabase.co:5432                 → IPv6-only on
#                                                                   newer projects
#
# The app holds the transaction pooler: many short transactions over few server
# connections, which is this API's shape. Migrations and the seed use the
# session pooler, because transaction pooling hands consecutive statements
# different backends and drizzle-kit relies on session state — it fails
# intermittently rather than loudly when pooled.
# The password goes INLINE in both URLs below, in the <password> slot:
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler...
#                 └── user ───────────┘ └ password ┘└──── host ────────┘
#
# It is written twice, once per URL, and that is deliberate. It used to live in
# a single DATABASE_PASSWORD var that the app substituted into a ${...}
# placeholder — which read well here and broke everywhere else, because Docker
# Compose and most hosting panels expand ${...} in their own layer before the
# process starts. The placeholder was resolved, usually to nothing, before the
# app ever saw it. One complete URL per environment survives that.
#
# Paste it as Supabase generated it, unquoted. The one thing to watch: nothing
# percent-encodes it for you any more, so a password containing @ : / # ? or %
# must be encoded by hand (@ → %40, # → %23). Unencoded, those characters move
# where the URL parser thinks the host begins, and it surfaces as an
# authentication error pointing nowhere near the cause. If yours has them,
# regenerating the password in Supabase is usually easier than escaping it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# require = TLS without certificate verification, which is what the poolers
# expect. verify-full additionally checks the chain and needs Supabase's CA
# distributed to every machine that connects. disable is for a local Postgres
# with no TLS.
DATABASE_SSL=require

# Leave false on the transaction pooler: a statement prepared on one backend is
# missing from the next, which surfaces as `prepared statement "sN" does not
# exist` under concurrency. Safe to enable on a session or direct connection.
DATABASE_PREPARE=false

# Connection pool, per API instance. On Supabase the number to compare this
# against is the pooler's client limit, not the database's max_connections —
# a small project allows far fewer of the former.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30

# ---- payments ----
# Shared secret for verifying payment webhooks: HMAC-SHA256 over the raw request
# body, sent as an x-signature header. At least 16 characters.
#
# Optional, and its absence is a closed door: with no secret set, every webhook
# is rejected. A missing secret must never mean "skip the check" — this value is
# the only thing standing between an HTTP request and marking an order paid.
PAYMENTS_WEBHOOK_SECRET=

# ---- redis ----
# Backs the rate limiter. No longer part of docker compose — leave this unset
# locally and the throttler keeps per-instance counters, which is fine for a
# single container. Set it in production, where more than one instance runs:
# without shared counters the enumeration limits on coupon validation and order
# lookup are only as strong as one pod's share of the traffic.
# REDIS_URL=redis://localhost:6379

# IANA zone the shop's business day runs on. The dashboard's "today" and its
# rolling windows are computed against this, not UTC — Dhaka is UTC+6, so a
# UTC-based dashboard would push every evening's orders onto the next day.
SHOP_TIMEZONE=Asia/Dhaka

# --- Admin panel -----------------------------------------------------------

# Signing key for admin access tokens. REQUIRED in production — the app
# refuses to boot without it. Generate with: openssl rand -base64 32
# Left blank in development, where a random key is generated each boot (which
# signs you out on restart, and cannot be accidentally shipped).
ADMIN_JWT_SECRET=

# Access token lifetime, seconds. Default 900 (15 min) — the window a stolen
# token keeps working. `sessions_valid_from` revokes faster when needed.
ADMIN_ACCESS_TOKEN_TTL=900

# Refresh token lifetime, seconds. Default 2592000 (30 days).
ADMIN_REFRESH_TOKEN_TTL=2592000

# Per-account lockout. Complements the per-IP throttle on /admin/auth/login:
# the throttle stops one address guessing many passwords, this stops many
# addresses guessing one account.
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_SECONDS=900

# `Secure` on the session cookies. Defaults to on outside development. Set to
# false only for a plain-HTTP staging box — with it on over HTTP the browser
# accepts the login response and then never sends the cookie back, which looks
# like "login succeeds then immediately logs out".
# ADMIN_COOKIE_SECURE=

# Cookie domain. Leave unset for a host-only cookie, which is correct when the
# panel is a route group in the Next.js app on the same origin as the API.
# ADMIN_COOKIE_DOMAIN=

# One-time password for the bootstrap admin created by:
#   npm run db:seed -- --admin-email=you@shop.com --admin-name="Your Name"
# Omit it and the seed generates one and prints it once. Never set in production.
# ADMIN_BOOTSTRAP_PASSWORD=

# Note on DELIVERY_FLAT_CENTS / FREE_DELIVERY_THRESHOLD_CENTS / WAREHOUSE_DIVISION
# above: these are now *fallbacks*. Once an admin saves a value in Settings →
# Shipping it is stored in `shop_settings` and this variable stops having any
# effect on that field. `GET /api/v1/admin/settings/shipping` reports which is
# in force via its `source` field.

# MongoDB holding the SMS payment gateway's parsed bKash/Nagad/Rocket
# transactions. Read-only; the database name comes from the URI's path.
# Unset, pre-order payments simply stay PENDING for manual verification.
MONGO_URI=

# --- Admin uploads (cover images, PDFs) -------------------------------------

# Supabase project URL and service-role key (Settings -> API -> service_role),
# used only by StorageService for admin uploads. Unset means the upload
# endpoints refuse with STORAGE_NOT_CONFIGURED; everything else works without
# them, including creating a book with a manually-typed cover URL.
# The bucket must exist and be public before uploads will work.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=book-assets
