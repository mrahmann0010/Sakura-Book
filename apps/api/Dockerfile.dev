# syntax=docker/dockerfile:1
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
RUN npm ci

COPY . .
RUN npm run prisma:generate --workspace @sakura/api

EXPOSE 4000
ENV PORT=4000
CMD ["npm", "run", "dev", "--workspace", "@sakura/api"]
