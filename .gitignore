node_modules/
.next/
out/
dist/
build/

/reference/

.env
.env.local
.env.*.local
# `.env` above does not cover a suffixed copy, and the migration off Supabase
# leaves exactly that behind: .env.supabase-backup, a verbatim copy of the old
# credentials kept so the switch can be reversed. Same secrets, same treatment.
.env.*-backup

# The same idea again, for the other direction: .env.prod-db holds the VPS
# Postgres credentials, kept verbatim while local development runs against a
# Docker Postgres instead. Live production secrets — never committed.
.env.prod-db

# Database dumps taken from production to seed the local container. Real
# customer orders, addresses and phone numbers — the most sensitive thing in
# the repo's working tree, and never committed. Regenerate with pg_dump rather
# than keeping one around; see docker-compose.yml.
/.local-db/

.turbo/
*.tsbuildinfo
next-env.d.ts

.DS_Store
*.log
npm-debug.log*
coverage/
.vscode/
.idea/

# Local editor history. These are timestamped snapshots of working files —
# including .env, which means live database credentials in plaintext. Ignored
# rather than curated: the directory is written automatically and anything in
# it is a copy of something already tracked or already ignored.
.history/

# Per-machine agent settings, and vendored skill directories that are tooling
# rather than product code.
.claude/settings.local.json
.claude/skills/
.github/skills/

# Agent critique notes — generated commentary about the code, not the code.
.impeccable/

# pdf.js runtime assets (worker, cmaps, standard fonts), copied out of the
# installed pdfjs-dist by apps/web/scripts/copy-pdfjs-assets.mjs on predev and
# prebuild. Generated, and must match the installed version — never committed.
/apps/web/public/pdfjs/
